# Docker Compose host ports. Compose publishes both services to loopback only.
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# Baked into the browser bundle while the web image builds. This must be a host-reachable
# HTTP(S) origin, never the Compose service name and never a secret.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Server-only API settings passed into the API container.
ARIZONIX_APP_ENVIRONMENT=development
ARIZONIX_APP_VERSION=0.1.0
ARIZONIX_LOG_LEVEL=info
ARIZONIX_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

