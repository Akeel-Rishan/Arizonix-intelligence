# Docker Compose host ports. Compose publishes both services to loopback only.
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# Baked into the browser bundle while the web image builds. This must be a host-reachable
# HTTP(S) origin, never the Compose service name and never a secret.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only API settings passed into the API container.
ARIZONIX_APP_ENVIRONMENT=development
ARIZONIX_APP_VERSION=0.1.0
ARIZONIX_LOG_LEVEL=info
ARIZONIX_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
ARIZONIX_SUPABASE_URL=https://your-project-ref.supabase.co
ARIZONIX_SUPABASE_JWT_AUDIENCE=authenticated

# Server-only PostgreSQL connections. The migration user owns schema changes; normal API
# requests use only the restricted arizonix_runtime role. Never prefix either with NEXT_PUBLIC_.
ARIZONIX_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:local-dev-only@127.0.0.1:55432/arizonix
ARIZONIX_RUNTIME_DATABASE_PASSWORD=replace-with-a-long-random-password
ARIZONIX_DATABASE_URL=postgresql+asyncpg://arizonix_runtime:replace-with-a-long-random-password@127.0.0.1:55432/arizonix
ARIZONIX_DATABASE_DISABLE_STATEMENT_CACHE=false
ARIZONIX_LOCAL_POSTGRES_PORT=55432
ARIZONIX_LOCAL_POSTGRES_DB=arizonix
ARIZONIX_LOCAL_POSTGRES_USER=postgres
ARIZONIX_LOCAL_POSTGRES_PASSWORD=local-dev-only
