# Public browser-visible API origin only. Do not include /api/v1 or any secret.
# This value is embedded into browser JavaScript when Next.js builds.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Public Supabase project settings. The publishable key is designed for browser use;
# never place the service-role key or another secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
