# Server-only API configuration. Values shown are safe local defaults.
ARIZONIX_APP_ENVIRONMENT=development
ARIZONIX_APP_VERSION=0.1.0
ARIZONIX_LOG_LEVEL=info
# Comma-separated browser origins. Wildcards, paths, queries, and fragments are rejected.
ARIZONIX_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Supabase project origin used to verify access JWTs. No Supabase secret is needed.
ARIZONIX_SUPABASE_URL=https://your-project-ref.supabase.co
ARIZONIX_SUPABASE_JWT_AUDIENCE=authenticated
# JWKS caching, unknown-key refresh throttling, HTTP timeout, and JWT clock skew.
ARIZONIX_SUPABASE_JWKS_CACHE_SECONDS=600
ARIZONIX_SUPABASE_JWKS_REFRESH_COOLDOWN_SECONDS=30
ARIZONIX_SUPABASE_HTTP_TIMEOUT_SECONDS=5
ARIZONIX_SUPABASE_JWT_CLOCK_SKEW_SECONDS=30

# Restricted runtime URL used for normal requests. Keep the privileged migration URL out of
# the running API environment. Use a direct or session-pooler connection, not transaction mode.
ARIZONIX_DATABASE_URL=postgresql+asyncpg://arizonix_runtime:replace_me@127.0.0.1:55432/arizonix
ARIZONIX_DATABASE_POOL_SIZE=5
ARIZONIX_DATABASE_MAX_OVERFLOW=5
ARIZONIX_DATABASE_POOL_TIMEOUT_SECONDS=10
ARIZONIX_DATABASE_DISABLE_STATEMENT_CACHE=false

# These are consumed only by the bootstrap/migration CLI, not by the API application.
ARIZONIX_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:replace_me@127.0.0.1:55432/arizonix
ARIZONIX_RUNTIME_DATABASE_PASSWORD=replace_me
